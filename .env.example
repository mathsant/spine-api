NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# MongoDB Atlas connection string for your cluster (Atlas UI -> Connect -> Drivers).
# Local docker-compose Mongo is legacy/optional — see docker-compose.yml.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app-name>
MONGO_DB_NAME=better_books
LOG_LEVEL=info

# auth (002-authregistration)
ACCESS_TOKEN_SECRET=dev-only-change-me-please-32-chars-min
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# books (003-bookcatalogflow)
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_TIMEOUT_MS=5000

# docker-compose only (legacy/optional local MongoDB, not read by the app)
MONGO_PORT=27017
